{
  "name": "dsh-usage",
  "version": "0.3.2",
  "description": "Model-aware active Codex account quotas and built-in DeepSeek account balance below the DSH composer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/0xlic/dsh-usage.git" },
  "homepage": "https://github.com/0xlic/dsh-usage#readme",
  "bugs": { "url": "https://github.com/0xlic/dsh-usage/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "build": "node build.mjs", "test": "node --test test/*.test.js", "check": "npm run build && npm test && node --check client.js && node --check index.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-model-selection"]
    }
  }
}
